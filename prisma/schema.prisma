generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String     @id @default(cuid())
  googleSub     String?    @unique
  name          String?
  email         String     @unique
  emailVerified DateTime?
  image         String?
  photoUrl      String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  progress      Progress[]
  accounts      Account[]
  sessions      Session[]

  @@map("users")
}

model PlanDay {
  day        Int      @id
  passage    String
  verseCount Int
  theme      String
  chapter    String
  sermonUrl  String?
  progress   Progress[]

  @@map("plan_days")
}

model Progress {
  id        String   @id @default(cuid())
  userId    String
  day       Int
  readAt    DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planDay   PlanDay  @relation(fields: [day], references: [day], onDelete: Cascade)

  @@unique([userId, day])
  @@index([userId])
  @@index([day])
  @@map("progress")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
